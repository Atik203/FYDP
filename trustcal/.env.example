# Copy to .env (gitignored — never commit real keys). Loaded automatically at
# import time by trustcal.config.load_env(); real environment variables win over
# file values, so a key exported on the pod is never clobbered.

# Required for the gated datasets (GPQA, HLE) — Phase 0 onward.
HF_TOKEN=

# Retrieval keys — optional in Phase 1 (only B2/B4), needed from Phase 2.
# PubMed and arXiv work without keys; Semantic Scholar needs one beyond ~1 req/s.
SEMANTIC_SCHOLAR_API_KEY=
PUBMED_API_KEY=

# External model keys for baselines.
# GEMINI_API_KEY: oracle baseline B7 (Phase 3) — primary.
# OPENAI_API_KEY: oracle fallback when Gemini is unavailable; no current code reads it.
GEMINI_API_KEY=
OPENAI_API_KEY=

# vLLM endpoints (informational; the client uses the ports from configs/models.yaml).
VLLM_BASE_URLS=http://127.0.0.1:8000/v1,http://127.0.0.1:8001/v1,http://127.0.0.1:8002/v1
