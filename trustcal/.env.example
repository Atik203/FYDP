# Copy to .env (gitignored). The pipeline reads these via os.getenv / dotenv.
# PubMed and ArXiv need no keys. Semantic Scholar key is optional but raises rate limits.

SEMANTIC_SCHOLAR_API_KEY=
GEMINI_API_KEY=

# vLLM endpoints (one per agent, in agent order 1-3).
VLLM_BASE_URLS=http://localhost:8000/v1,http://localhost:8001/v1,http://localhost:8002/v1
